# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (matches docker-compose defaults)
DATABASE_URL=mysql://appointly:appointly@127.0.0.1:3306/appointly

# Redis (host 16379 — Windows may reserve 6379)
REDIS_URL=redis://127.0.0.1:16379/0

# RabbitMQ / Celery (host 25672 — Windows may reserve 5672)
CELERY_BROKER_URL=amqp://appointly:appointly@127.0.0.1:25672//
CELERY_RESULT_BACKEND=redis://127.0.0.1:16379/1

# Auth
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Sentry (optional)
SENTRY_DSN=

# SMS (dev: mock adapter)
SMS_ADAPTER=mock

# Customer OTP rate limits
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_SEND_INTERVAL_SECONDS=60
OTP_DAILY_SEND_LIMIT=10
OTP_MAX_VERIFY_FAILURES=5
OTP_LOCK_SECONDS=900
