# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-domain.com

# Database
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=appointly
MYSQL_USER=appointly
MYSQL_PASSWORD=
DATABASE_URL=mysql://appointly:CHANGE_ME@mysql:3306/appointly

# Redis
REDIS_URL=redis://redis:6379/0

# RabbitMQ / Celery
RABBITMQ_USER=appointly
RABBITMQ_PASSWORD=
CELERY_BROKER_URL=amqp://appointly:CHANGE_ME@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1
OUTBOX_MESSAGE_BROKER=rabbitmq

# Docker image tag (set by deploy workflow)
IMAGE_TAG=latest

# Sentry (optional)
SENTRY_DSN=

# OpenTelemetry → Jaeger (optional)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=appointly-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# SMS
SMS_ADAPTER=mock
